# TeamFlow env template
# Copy this file to .env and replace values for your environment.

# REQUIRED
# Local example URL. For production, use your Neon pooled connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/teamflow

# Use strong random values (32+ chars each) in shared/public deployments.
JWT_ACCESS_SECRET=replace_with_32_plus_char_random_secret
JWT_REFRESH_SECRET=replace_with_32_plus_char_random_secret

# OPTIONAL
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
APP_URL=http://localhost:5000
