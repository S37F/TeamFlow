# TeamFlow — copy to .env (cp .env.example .env  /  Copy-Item .env.example .env)

# REQUIRED — local example URL (replace with Neon pooled connection string in production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/teamflow

# Local-only; use strong unique values for any shared or public deployment
JWT_ACCESS_SECRET=local_dev_only_jwt_access_secret_change_me_32chars_min
JWT_REFRESH_SECRET=local_dev_only_jwt_refresh_secret_change_me_32chars_min

# OPTIONAL
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
APP_URL=http://localhost:5000
